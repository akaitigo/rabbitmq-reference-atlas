{
  "transport": "container-exec",
  "ping": {
    "command": [
      "docker",
      "compose",
      "-f",
      "environments/compose.yaml",
      "exec",
      "-T",
      "rabbitmq-3",
      "rabbitmq-diagnostics",
      "-q",
      "ping"
    ],
    "returncode": 0,
    "stdout": "Ping succeeded\n",
    "stderr": ""
  },
  "check_running": {
    "command": [
      "docker",
      "compose",
      "-f",
      "environments/compose.yaml",
      "exec",
      "-T",
      "rabbitmq-3",
      "rabbitmq-diagnostics",
      "-q",
      "check_running"
    ],
    "returncode": 0,
    "stdout": "RabbitMQ on node rabbit@rabbitmq-3 is fully booted and running\n",
    "stderr": ""
  }
}
